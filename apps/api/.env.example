# Copie para apps/api/.env e ajuste. NÃO commite segredos.

# PostgreSQL (local via docker-compose ou Railway)
DATABASE_URL="postgresql://equilibrio:equilibrio@localhost:5432/equilibrio?schema=public"

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
CLINIC_NAME="Equilíbrio Fisioterapia e Bem-Estar"

# Pasta de fotos (fallback local; Railway volume se não usar nuvem)
# UPLOADS_DIR="/data/uploads"

# Storage em nuvem (recomendado: Cloudflare R2 ou AWS S3)
# Upload direto do navegador — vídeos grandes não passam pela memória da API
# S3_BUCKET="equilibrio-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# Cloudflare R2:
# S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"
# URL pública (custom domain ou r2.dev) — se vazio, leitura via /api/media
# S3_PUBLIC_BASE_URL="https://media.seudominio.com"
# Limites (MB)
# STORAGE_MAX_IMAGE_MB="12"
# STORAGE_MAX_VIDEO_MB="512"
# STORAGE_MAX_DOC_MB="50"

# WhatsApp: console | evolution | meta | none
# Número de origem da clínica (E.164 sem +): +55 48 98488-2418
CLINIC_WHATSAPP="5548984882418"
WHATSAPP_PROVIDER="console"
# Evolution (instância conectada ao WhatsApp da clínica acima):
# WHATSAPP_EVOLUTION_URL="https://sua-evolution"
# WHATSAPP_EVOLUTION_INSTANCE="equilibrio"
# WHATSAPP_EVOLUTION_APIKEY="sua-chave"
# Meta Cloud API (Phone Number ID do mesmo número da clínica):
# WHATSAPP_META_TOKEN=""
# WHATSAPP_META_PHONE_ID=""

# E-mail: console | smtp | none
EMAIL_PROVIDER="console"
# SMTP_HOST="smtp.seudominio.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
# SMTP_FROM="Equilíbrio Fisioterapia <financeiro@equilibriobe.com.br>"
